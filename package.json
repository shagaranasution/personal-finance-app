{
  "name": "personal-finance-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @personal-finance/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "preview": "npm run preview --workspace @personal-finance/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build",
    "dev:api": "npm run dev --workspace @personal-finance/api",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace @personal-finance/api",
    "db:status": "npm run db:status --workspace @personal-finance/api",
    "test:api": "npm run test --workspace @personal-finance/api",
    "db:seed": "npm run db:seed --workspace @personal-finance/api",
    "test:web": "npm run test --workspace @personal-finance/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
